# ── Server ────────────────────────────────────────────
# Port the API listens on inside the container
PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# ── Database (MySQL 8) ────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_NAME=magi
DB_USER=magi
DB_PASSWORD=cambiami

# ── Auth ──────────────────────────────────────────────
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=cambiami-con-una-stringa-casuale-di-almeno-32-caratteri
# Token lifetime in seconds (43200 = 12 hours)
JWT_EXPIRATION=43200
# Operator account, created (or its password reset) at every start. Password >= 12 chars.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiami-subito

# Comma-separated origins allowed by CORS. Leave empty: the browser never calls the
# backend directly, the SvelteKit server does.
CORS_ORIGINS=

# ── MELCHIOR-1 · Anthropic Claude ─────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | max
ANTHROPIC_EFFORT=medium

# ── BALTHASAR-2 · OpenAI ──────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# low | medium | high
OPENAI_REASONING_EFFORT=medium

# ── CASPER-3 · Google Gemini ──────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
# low | high
GEMINI_THINKING_LEVEL=high

# ── Limits ────────────────────────────────────────────
# Deliberations a user can start per hour (each = up to 6 paid model calls)
DELIBERATIONS_PER_HOUR=30
MAX_CONCURRENT_DELIBERATIONS=3
# Max seconds to wait for a single core's answer
CORE_TIMEOUT_SECONDS=240

# Optional provider endpoint overrides (proxies, local mocks for tests)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
